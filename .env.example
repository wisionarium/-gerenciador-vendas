# Copie para .env (nunca commite o .env com segredos reais)
# Local: deixe vazio para usar ./data.db
# Vercel: preencha com os dados do Turso
TURSO_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=troque-por-uma-frase-longa-aleatoria
PORT=3000
# Push (Web Push/VAPID): gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@sellday.app
# Cron de notificações: mesmo valor na Vercel e no agendador externo (?secret= ou Bearer)
CRON_SECRET=troque-por-um-token-longo-aleatorio
